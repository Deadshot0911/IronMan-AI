# Copy these settings into the root .env file. Never commit the real key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail sending (use a Google App Password, not your normal password)
JARVIS_SMTP_HOST=smtp.gmail.com
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=you@gmail.com
JARVIS_SMTP_PASSWORD=your-16-character-app-password
JARVIS_EMAIL_FROM=you@gmail.com

# Optional overrides
# JARVIS_SMTP_USE_SSL=0
# JARVIS_IMAP_HOST=imap.gmail.com
# JARVIS_IMAP_PORT=993
# JARVIS_GOOGLE_CREDENTIALS=jarvis_google_credentials.json
# JARVIS_GOOGLE_TOKEN=jarvis_google_token.json
# JARVIS_CONTACTS_FILE=jarvis_contacts.json
# JARVIS_SEARCH_DIRS=C:\Projects;D:\Documents
# JARVIS_VISION_MODEL=gemini-3.5-flash,gemini-3-flash-preview
